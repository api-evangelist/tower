        {
          "id": "606f721d-34bd-4082-a2f6-79b236bddda7",
          "name": "Generate run statistics",
          "request": {
            "name": "Generate run statistics",
            "description": {
              "content": "Generates statistics about runs over a specified time period.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stats",
                "runs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "pending,starting,running,crashed,errored,exited,cancelled,retrying",
                  "description": "Filter runs by status(es). Define multiple with a comma-separated list. Supplying none will return all statuses."
                },
                {
                  "disabled": false,
                  "key": "start_at",
                  "value": "<dateTime>",
                  "description": "(Required) Start date and time for statistics (inclusive)"
                },
                {
                  "disabled": false,
                  "key": "end_at",
                  "value": "<dateTime>",
                  "description": "(Required) End date and time for statistics (inclusive)"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "UTC",
                  "description": "Timezone for the statistics (e.g., 'Europe/Berlin'). Defaults to UTC."
                },
                {
                  "disabled": false,
                  "key": "environment",
                  "value": "<string>",
                  "description": "Filter runs by environment. If not provided, all environments will be included."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
