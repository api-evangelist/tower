{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tower Accounts Teams API",
    "version": "v0.11.16"
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/teams",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to fetch."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records to fetch on each page."
              }
            ]
          },
          "docs": "List all the teams that you are a member of."
        },
        {
          "info": {
            "name": "Create team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new team"
        },
        {
          "info": {
            "name": "Delete team",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tower.dev/v1/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a new team"
        },
        {
          "info": {
            "name": "Describe team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/teams/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to fetch."
              }
            ]
          },
          "docs": "Get details about a team, including its members and invitations."
        },
        {
          "info": {
            "name": "Update team",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tower.dev/v1/teams/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a team with a new name or name. Note that updating the team with a new name will cause all your URLs to change!"
        },
        {
          "info": {
            "name": "List team invitations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/teams/:name/invites",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to list members for"
              }
            ]
          },
          "docs": "List the pending invitations for a team"
        },
        {
          "info": {
            "name": "Invite team member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/teams/:name/invites",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to invite someone to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite a new team"
        },
        {
          "info": {
            "name": "Delete team invitation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tower.dev/v1/teams/:name/invites",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to remove someone from"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a pending team invitation that you have previously sent"
        },
        {
          "info": {
            "name": "Resend team invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/teams/:name/invites/resend",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to invite someone to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Resend a team invitation to a user if they need a reminder or if they lost it"
        },
        {
          "info": {
            "name": "Leave team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/teams/:name/leave",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to leave"
              }
            ]
          },
          "docs": "Remove yourself from a team. If you're the last member of a team, you cannot remove yourself. You should delete the team instead."
        },
        {
          "info": {
            "name": "List team members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/teams/:name/members",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to list members for"
              }
            ]
          },
          "docs": "List the members of a team"
        },
        {
          "info": {
            "name": "Update team member",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tower.dev/v1/teams/:name/members",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update team member"
        },
        {
          "info": {
            "name": "Remove team member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tower.dev/v1/teams/:name/members",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the team to remove someone from"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove team member"
        }
      ]
    }
  ],
  "bundled": true
}