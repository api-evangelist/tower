{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tower Accounts Runners API",
    "version": "v0.11.16"
  },
  "items": [
    {
      "info": {
        "name": "Runners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List runners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/runners",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to fetch."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records to fetch on each page."
              }
            ]
          },
          "docs": "Get all self-hosted runners for the current account."
        },
        {
          "info": {
            "name": "Generate runner credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/runners/credentials"
          },
          "docs": "Uses your current authentication context to generate runner credentials that are used for authenticating runner requests"
        }
      ]
    }
  ],
  "bundled": true
}