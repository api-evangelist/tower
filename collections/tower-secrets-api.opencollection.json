{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tower Accounts Secrets API",
    "version": "v0.11.16"
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/secrets",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to fetch."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records to fetch on each page."
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "The environment to filter by."
              },
              {
                "name": "all",
                "value": "",
                "type": "query",
                "description": "Whether to fetch all secrets or only the ones that are not marked as deleted."
              }
            ]
          },
          "docs": "Lists all the secrets associated with your current account."
        },
        {
          "info": {
            "name": "Create secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new secret and associates it with the current account."
        },
        {
          "info": {
            "name": "List secret environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/secrets/environments"
          },
          "docs": "Lists all the environments associated with secrets."
        },
        {
          "info": {
            "name": "Export secrets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/secrets/export",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists all the secrets in your current account and re-encrypt them with the public key you supplied."
        },
        {
          "info": {
            "name": "Describe encryption key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/secrets/key",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "The format to return the key in. Options are 'pkcs1' and 'spki'."
              }
            ]
          },
          "docs": "Gets the encryption key used for encrypting secrets that you want to create in Tower."
        },
        {
          "info": {
            "name": "Update secret",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tower.dev/v1/secrets/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a secret that has previously been created in your account"
        },
        {
          "info": {
            "name": "Delete secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tower.dev/v1/secrets/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the secret to delete."
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "The environment of the secret to delete."
              }
            ]
          },
          "docs": "Delete a secret by name."
        }
      ]
    }
  ],
  "bundled": true
}