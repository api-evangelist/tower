{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tower Accounts Session API",
    "version": "v0.11.16"
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Describe session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tower.dev/v1/session"
          },
          "docs": "Validate your current session and return the user information associated with the session."
        },
        {
          "info": {
            "name": "Create session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new session and return it."
        },
        {
          "info": {
            "name": "Delete session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tower.dev/v1/session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Terminate a session and revoke the access keys associated with it."
        },
        {
          "info": {
            "name": "Refresh session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tower.dev/v1/session/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "If your access tokens expire, this API endpoint takes a Refresh Token and returns a new set of Access Tokens for your session. Note that we don't rotate the Refresh Token itself, and it's not returned by this API endpoint."
        }
      ]
    }
  ],
  "bundled": true
}